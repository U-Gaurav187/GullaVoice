# Optional Cloud AI API Keys
# The application starts and runs 100% without any secret keys.
# All core features (Zero-Key Local Engine, Rate Card, Customer Ledgers, Debtors PDF) run in-app locally.
# If you wish to enable Cloud AI features, provide the keys below or paste them in the in-app Settings (⚙️).

# Free Groq Cloud API Key (Optional - https://console.groq.com/keys)
VITE_GROQ_API_KEY=your_groq_api_key_here

# Free Google Gemini API Key (Optional - https://aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Wispr Flow API Key (Optional - https://wisprflow.ai)
VITE_WISPR_FLOW_API_KEY=your_wispr_flow_api_key_here
